__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.DS_Store

# Campaign working directories are reproducible outputs, not source.
# The worked example under campaigns/*/runs/ is regenerated by `studio run`.
campaigns/*/runs/
!campaigns/*/runs/.gitkeep
.cache/

# Generated corpora. Reproducible with `studio build-corpus` from the seed in
# campaign.yaml; see examples/ for rendered output from a reference run.
campaigns/*/corpus/
